# ---- Local data, never published -------------------------------------------
# A source run writes everything it learns into data\ at the project root (a
# build uses %LOCALAPPDATA%): the DPAPI-protected secrets file, the Steam
# response cache, downloaded thumbnails, the Rotator's and the tracker's
# history, real folder paths from this machine. None of it is source, all of it
# is personal, and some of it is large.
/data/

# ---- Build output ----------------------------------------------------------
/build/
/dist/
*.manifest

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Editors and OS --------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
